{
    "name": "obsidian-github-tree",
    "version": "1.0.0",
    "description": "Browse GitHub repository file trees in Obsidian",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "docs:test": "node scripts/docs-contract.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "author": "Brookky",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "builtin-modules": "3.3.0",
        "esbuild": "0.24.2",
        "obsidian": "latest",
        "tslib": "2.6.0",
        "typescript": "5.6.3"
    }
}
